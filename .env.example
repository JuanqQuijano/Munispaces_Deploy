# Copy to apps/api/.env and apps/web/.env.local as needed.

# --- API (apps/api/.env) ---
# Local sin Docker:
DATABASE_URL=sqlite:///./munispaces.db
# Con Postgres:
# DATABASE_URL=postgresql+psycopg://munispaces:munispaces@localhost:5432/munispaces
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
CORS_ORIGINS=http://localhost:3000
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ADMIN_USERNAME=Admin01
ADMIN_PASSWORD=123654

# --- Web (apps/web/.env.local) ---
# Copia tambien apps/web/.env.example -> apps/web/.env.local
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
